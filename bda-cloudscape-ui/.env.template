# BDA IDP Solution - Environment Configuration Template
#
# INSTRUCTIONS:
# 1. Copy this file to .env
# 2. Deploy CDK stacks: `cdk deploy --all`
# 3. Replace placeholder values with outputs from CDK deployment
# 4. NEVER commit the .env file to git!

# =============================================================================
# COGNITO AUTHENTICATION
# =============================================================================
# Get these from: CDK output after deploying BDAAuthStack
VITE_USER_POOL_ID=<UserPoolId-from-CDK-output>
VITE_USER_POOL_CLIENT_ID=<UserPoolClientId-from-CDK-output>
VITE_IDENTITY_POOL_ID=<IdentityPoolId-from-CDK-output>

# =============================================================================
# AWS CONFIGURATION
# =============================================================================
# Set to your deployment region (e.g., us-west-2, us-east-1, eu-west-1)
VITE_AWS_REGION=<your-deployment-region>

# =============================================================================
# S3 STORAGE
# =============================================================================
# Get from: CDK output after deploying BDAStorageStack
VITE_S3_BUCKET=<DocumentBucketName-from-CDK-output>

# =============================================================================
# AGENTCORE CONFIGURATION
# =============================================================================
# Get from: CDK output after deploying AgentCoreStack
VITE_AGENTCORE_RUNTIME_ARN=<AgentCoreRuntimeArn-from-CDK-output>

# =============================================================================
# DYNAMODB TABLES
# =============================================================================
# Get from: CDK output after deploying BDAStorageStack
VITE_DYNAMODB_TABLE_NAME=<ProcessingStatusTableName-from-CDK-output>
VITE_DYNAMODB_METRICS_TABLE_NAME=<MetricsTableName-from-CDK-output>

# =============================================================================
# KNOWLEDGE BASE (Optional)
# =============================================================================
# Get from: CDK output after deploying KnowledgeBaseStack
KNOWLEDGE_BASE_ID=<KnowledgeBaseId-from-CDK-output>
KNOWLEDGE_BASE_DATA_SOURCE_ID=<DataSourceId-from-CDK-output>
KNOWLEDGE_BASE_NAME=<KnowledgeBaseName-from-CDK-output>

# =============================================================================
# IAM ROLES (For Reference Only)
# =============================================================================
AGENTCORE_EXECUTION_ROLE_ARN=<AgentCoreExecutionRoleArn-from-CDK-output>
ECR_PUSH_ROLE_ARN=<ECRPushRoleArn-from-CDK-output>

# =============================================================================
# BUILD CONFIGURATION (Optional)
# =============================================================================
# VITE_ENVIRONMENT=development
# VITE_BUILD_TIMESTAMP=<set-automatically-during-build>