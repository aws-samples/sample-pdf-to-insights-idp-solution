# Large directories that slow down Docker build context
node_modules/
bda-cloudscape-ui/node_modules/
bda-cloudscape-ui/dist/
bda-ui-dashboard/node_modules/
bda-ui-dashboard/dist/

# CDK build artifacts
cdk.out/
.cdk.staging/
cdk.context.json

# Lambda layers (built packages, not needed in Docker images)
lambda_layers/*/python/
lambda_layers/*/nodejs/
lambda_layers/**/*.zip

# Deployment scripts and logs
deployment.log
logs/
scripts/cleanup.sh
deploy.sh

# AWS credentials (NEVER in Docker images)
.aws/
aws.config
aws.credentials
*.pem

# Keep wheelhouse for offline installations
# wheelhouse/
