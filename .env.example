# BDA AgentCore Environment Configuration Template
# Copy this file to .env and update with your actual values

# =============================================================================
# AWS Configuration
# =============================================================================
AWS_PROFILE=ML
AWS_DEFAULT_REGION=us-west-2
BEDROCK_REGION=us-west-2

# =============================================================================
# Environment Configuration
# =============================================================================
ENVIRONMENT=Dev
# Options: Dev, Staging, Prod

# =============================================================================
# Knowledge Base Configuration (set after CDK deployment)
# =============================================================================
# To get the KB ID after deployment:
# aws cloudformation describe-stacks --stack-name <your-stack-name> --query 'Stacks[0].Outputs[?OutputKey==`KnowledgeBaseId`].OutputValue' --output text
KNOWLEDGE_BASE_ID=YOUR_KB_ID_HERE
KNOWLEDGE_BASE_DATA_SOURCE_ID=YOUR_DATASOURCE_ID_HERE
KNOWLEDGE_BASE_NAME=BDACDK-Knowledge-Base-dev

# =============================================================================
# External API Keys (for External API Agent)
# =============================================================================

# Alpha Vantage - Stock Market Data
# Get free API key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=demo
# Note: "demo" will return errors. Use real API key for actual data.

# CoinMarketCap - Cryptocurrency Data  
# Get API key at: https://coinmarketcap.com/api/
CMC_API_KEY=demo

# FRED (Federal Reserve Economic Data) - Economic Indicators
# Get free API key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=demo

# News API - Market News and Sentiment
# Get API key at: https://newsapi.org/
NEWS_API_KEY=demo

# Real Estate APIs (for future expansion)
REAL_ESTATE_API_KEY=demo
BATCHDATA_API_KEY=demo
BRIGHTDATA_API_KEY=demo
ZILLOW_API_KEY=demo

# =============================================================================
# Model Configuration (for Investment Advisory Agent)
# =============================================================================
# Investment Advisory agent can use Nova Pro or Claude Sonnet 4 for better advice
INVESTMENT_ADVISORY_MODEL_ID=anthropic.claude-sonnet-4-5-20250929-v1:0
# Alternative: us.anthropic.nova-pro-v1:0

# =============================================================================
# AWS Infrastructure (automatically set by deploy script)
# =============================================================================
AGENTCORE_EXECUTION_ROLE_ARN=
ECR_PUSH_ROLE_ARN=

# =============================================================================
# Monitoring and Observability
# =============================================================================
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARN, ERROR

# OpenTelemetry for CloudWatch observability
AGENT_OBSERVABILITY_ENABLED=true
OTEL_PYTHON_DISTRO=aws_distro
OTEL_PYTHON_CONFIGURATOR=aws_configurator

# =============================================================================
# Development Configuration
# =============================================================================
# For local testing and development
PYTHONPATH=/app
PYTHONUNBUFFERED=1

# =============================================================================
# IMPORTANT NOTES
# =============================================================================
# 1. Replace "demo" values with real API keys for production use
# 2. Knowledge Base ID is set automatically by the deploy script
# 3. Some agents will return "data not available" messages when API keys are not configured
# 4. The system works with "demo" keys but provides limited functionality
# 5. For full functionality, obtain real API keys from the respective services